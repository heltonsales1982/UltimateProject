  "decision_rules": {
    "rule_1": {
      "rule_code": "PAIN_BLOCKS_PROGRESSION",
      "condition_field": "pain_level",
      "operator": "gt",
      "threshold_value": 6,
      "threshold_value_secondary": null,
      "action_code": "BLOCK_PROGRESSION",
      "priority": 1,
      "active": true
    },
    "rule_2": {
      "rule_code": "SLEEP_DEFICIT_RECOVERY",
      "condition_field": "sleep_avg",
      "operator": "lt",
      "threshold_value": 5.5,
      "threshold_value_secondary": null,
      "action_code": "PRIORITIZE_RECOVERY",
      "priority": 2,
      "active": true
    },
    "rule_3": {
      "rule_code": "RAPID_WEIGHT_LOSS_FLAG",
      "condition_field": "weight_delta_kg",
      "operator": "gt",
      "threshold_value": 1.5,
      "threshold_value_secondary": null,
      "action_code": "SUGGEST_NUTRITION_REVIEW",
      "priority": 5,
      "active": true
    },
    "rule_4": {
      "rule_code": "PROGRESSION_HIGH_ADHERENCE",
      "condition_field": "adherence_total",
      "operator": "gt",
      "threshold_value": 85,
